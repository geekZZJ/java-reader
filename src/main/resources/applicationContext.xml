    <!--    <mvc:interceptor>-->
    <!--        <mvc:mapping path="/**"/>-->
    <!--        <bean class="com.example.springmvc.interceptor.MyInterceptor"></bean>-->
    <!--    </mvc:interceptor>-->
    <!--</mvc:interceptors>-->
</beans>